# Public stateless mode: no database, history API or profile cookies.
# Production Docker sets these defaults automatically.
PUBLIC_MODE=true
PORT=8000
# Set only after building frontend; omit for API-only local development.
# STATIC_DIR=../frontend/dist
GIT_SHA=development
# Leave empty for the same-origin frontend or the local Vite /api proxy.
CORS_ALLOW_ORIGINS=

# Legacy database tooling/tests remain in the repository for migration reference.
# They require PUBLIC_MODE=false and explicit database/history configuration.
