# API calls use relative /api paths. Set the Vite proxy target in .env.local.
# Monorepo Docker UI + API: http://127.0.0.1:18081 (public mode, no database).
# Standalone monorepo backend for Vite development (README.md):
BACKEND_DEV_URL=http://127.0.0.1:8000
# Match the feature flags used by the root production Dockerfile.
VITE_PUBLIC_MODE=true
VITE_ENABLE_HILL=true

# DES uses labeled local fixtures only; keep disabled for normal releases.
VITE_ENABLE_DES_DEMO=false

# Use the real monorepo DES API.
VITE_ENABLE_DES=true

# RSA and Diffie–Hellman use the same monorepo API origin.
VITE_ENABLE_RSA=true

VITE_ENABLE_DIFFIE_HELLMAN=true
