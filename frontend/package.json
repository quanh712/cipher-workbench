{
  "name": "caesar-cipher-fe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:rsa": "VITE_ENABLE_RSA=true vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:hill": "playwright test --config playwright.hill.config.ts",
    "test:e2e:integration": "playwright test --config playwright.integration.config.ts",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "check:all": "npm run check && npm run test:e2e",
    "test:e2e:hill:integration": "playwright test --config playwright.hill-integration.config.ts",
    "test:e2e:rsa": "playwright test --config playwright.rsa.config.ts",
    "test:e2e:diffie-hellman": "playwright test --config playwright.diffie-hellman.config.ts",
    "test:e2e:des": "playwright test --config playwright.des.config.ts",
    "test:e2e:des:integration": "playwright test --config playwright.des-integration.config.ts",
    "test:e2e:rsa:integration": "playwright test --config playwright.rsa-integration.config.ts",
    "test:integration:diffie-hellman": "playwright test --config playwright.diffie-hellman-integration.config.ts"
  },
  "dependencies": {
    "preact": "^11.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "preact-render-to-string": "^6.8.3",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
